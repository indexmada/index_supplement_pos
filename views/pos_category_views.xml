<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Inherit POS Category Form View -->
        <record id="view_pos_category_form_inherit" model="ir.ui.view">
            <field name="name">pos.category.form.inherit</field>
            <field name="model">pos.category</field>
            <field name="inherit_id" ref="point_of_sale.product_pos_category_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='color']" position="after">
                    <field name="is_accompaniment" string="Is Accompaniment"/>
                </xpath>
            </field>
        </record>
        
        <!-- Inherit POS Category Tree View -->
        <record id="view_pos_category_tree_inherit" model="ir.ui.view">
            <field name="name">pos.category.tree.inherit</field>
            <field name="model">pos.category</field>
            <field name="inherit_id" ref="point_of_sale.product_pos_category_tree_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='display_name']" position="after">
                    <field name="is_accompaniment" string="Accompaniment"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
